# GitLab deploy token for Flux to pull the cluster repo
# Encrypt: sops --age <key> -e gitlab-token-secret.plain.yaml > gitlab-token-secret.yaml
# Then: rm gitlab-token-secret.plain.yaml — NEVER commit plaintext
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_repo_secret }}
  namespace: flux-system
type: Opaque
stringData:
  username: {{ cluster_repo_gitlab_username }}
  password: {{ cluster_repo_gitlab_token }}
