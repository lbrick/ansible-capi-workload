# CCM cloud-config Secret for ClusterResourceSet — applied to management cluster by Flux (SOPS encrypted)
# ClusterResourceSet applies the embedded manifest to the workload cluster's kube-system.
#
# Encrypt: sops -e ccm-cloud-config.plain.yaml > ccm-cloud-config.yaml
# Then:    rm ccm-cloud-config.plain.yaml — NEVER commit plaintext
#
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_name }}-ccm-cloud-secret
  namespace: {{ cluster_namespace }}
stringData:
  cloud-config.yaml: |
    apiVersion: v1
    kind: Secret
    metadata:
      name: cloud-config
      namespace: kube-system
    data:
      cloud.conf: {{ _ccm_cloud_conf_b64 }}
