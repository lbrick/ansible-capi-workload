# CAPI cloud-config Secret — applied to management cluster by Flux (SOPS encrypted)
#
# Encrypt: sops -e cloud-config.plain.yaml > cloud-config.yaml
# Then:    rm cloud-config.plain.yaml — NEVER commit plaintext
#
apiVersion: v1
kind: Secret
metadata:
  name: {{ cluster_name }}-cloud-config
  namespace: {{ cluster_namespace }}
  labels:
    clusterctl.cluster.x-k8s.io/move: "true"
{% if enable_velero %}
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: velero
{% endif %}
stringData:
  cacert: ""
  clouds.yaml: |
{{ _clouds_yaml_raw | indent(4, first=true) }}
