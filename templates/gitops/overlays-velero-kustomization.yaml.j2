apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - velero-namespace.yaml
  - ../../cloud-config.yaml
patches:
  - target:
      kind: Secret
      name: {{ cluster_name }}-cloud-config
    patch: |-
      - op: replace
        path: /metadata/name
        value: openstack-credentials
      - op: replace
        path: /metadata/namespace
        value: velero
