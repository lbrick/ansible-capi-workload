apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - velero-namespace.yaml
  - ../../cloud-config.yaml
  - openstack-credentials.yaml
replacements:
  - source:
      kind: Secret
      name: {{ cluster_name }}-cloud-config
      fieldPath: stringData.clouds\.yaml
    targets:
      - select:
          kind: Secret
          name: openstack-credentials
        fieldPaths:
          - stringData.clouds\.yaml
  - source:
      kind: Secret
      name: {{ cluster_name }}-cloud-config
      fieldPath: stringData.cacert
    targets:
      - select:
          kind: Secret
          name: openstack-credentials
        fieldPaths:
          - stringData.cacert
