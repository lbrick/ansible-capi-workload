---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ cluster_name }}-root
  namespace: flux-system
spec:
  interval: 5m
  path: ./
  prune: true
  dependsOn:
    - name: workload-components
  sourceRef:
    kind: GitRepository
    name: {{ cluster_name }}
  decryption:
    provider: sops
    secretRef:
      name: sops-age
